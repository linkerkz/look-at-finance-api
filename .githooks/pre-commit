#!/bin/bash
#
# Pre-commit hook for Go projects
# Runs fast checks: formatting, linting, unit tests
# Target: <15 seconds total execution
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Timing
START_TIME=$(date +%s)

echo -e "${BLUE}=== Pre-commit Hook ===${NC}"
echo ""

# Get list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo -e "${YELLOW}No Go files staged for commit. Skipping checks.${NC}"
    exit 0
fi

echo -e "${BLUE}Checking $(echo "$STAGED_GO_FILES" | wc -l) staged Go file(s)...${NC}"
echo ""

# Track failures
FAILED=0

# ============================================================
# 1. Check gofmt formatting
# ============================================================
echo -e "${BLUE}[1/4] Checking gofmt formatting...${NC}"
STEP_START=$(date +%s)

UNFORMATTED=$(gofmt -l $STAGED_GO_FILES 2>&1 || true)

if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}FAILED${NC} - The following files need formatting:"
    echo "$UNFORMATTED" | sed 's/^/  /'
    echo ""
    echo -e "Run: ${YELLOW}gofmt -w <file>${NC}"
    FAILED=1
else
    STEP_END=$(date +%s)
    echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
fi
echo ""

# ============================================================
# 2. Check goimports (if available)
# ============================================================
echo -e "${BLUE}[2/4] Checking goimports...${NC}"
STEP_START=$(date +%s)

if command -v goimports &> /dev/null; then
    UNIMPORTED=$(goimports -l $STAGED_GO_FILES 2>&1 || true)

    if [ -n "$UNIMPORTED" ]; then
        echo -e "${RED}FAILED${NC} - The following files have import issues:"
        echo "$UNIMPORTED" | sed 's/^/  /'
        echo ""
        echo -e "Run: ${YELLOW}goimports -w <file>${NC}"
        FAILED=1
    else
        STEP_END=$(date +%s)
        echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
    fi
else
    echo -e "${YELLOW}SKIPPED${NC} - goimports not installed"
    echo -e "Install: ${YELLOW}go install golang.org/x/tools/cmd/goimports@latest${NC}"
fi
echo ""

# ============================================================
# 3. Run golangci-lint
# ============================================================
echo -e "${BLUE}[3/4] Running golangci-lint...${NC}"
STEP_START=$(date +%s)

if command -v golangci-lint &> /dev/null; then
    # Run linter only on changed packages
    CHANGED_PACKAGES=$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u | sed 's/^/.\//' | tr '\n' ' ')

    if golangci-lint run --new-from-rev=HEAD --timeout=60s $CHANGED_PACKAGES 2>&1; then
        STEP_END=$(date +%s)
        echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
    else
        echo -e "${RED}FAILED${NC} - Linting errors found"
        FAILED=1
    fi
else
    echo -e "${YELLOW}SKIPPED${NC} - golangci-lint not installed"
    echo -e "Install: ${YELLOW}go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest${NC}"
fi
echo ""

# ============================================================
# 4. Run unit tests (short mode)
# ============================================================
echo -e "${BLUE}[4/4] Running unit tests (short mode)...${NC}"
STEP_START=$(date +%s)

# Run tests with short flag and timeout
if go test -short -timeout 10s ./... 2>&1; then
    STEP_END=$(date +%s)
    echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
else
    echo -e "${RED}FAILED${NC} - Unit tests failed"
    FAILED=1
fi
echo ""

# ============================================================
# Summary
# ============================================================
END_TIME=$(date +%s)
TOTAL_TIME=$(($END_TIME - $START_TIME))

echo -e "${BLUE}=== Summary ===${NC}"
echo -e "Total time: ${TOTAL_TIME}s"
echo ""

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}Pre-commit checks FAILED${NC}"
    echo ""
    echo -e "Fix the issues above, or bypass with: ${YELLOW}git commit --no-verify${NC}"
    exit 1
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0

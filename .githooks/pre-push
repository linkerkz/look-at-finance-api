#!/bin/bash
#
# Pre-push hook for Go projects
# Runs comprehensive checks: full test suite, static analysis, security scanning
# Executes before git push
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Timing
START_TIME=$(date +%s)

echo -e "${BLUE}=== Pre-push Hook ===${NC}"
echo ""

# Track failures
FAILED=0

# ============================================================
# 1. Run full test suite
# ============================================================
echo -e "${BLUE}[1/4] Running full test suite...${NC}"
STEP_START=$(date +%s)

if go test -race -timeout 5m ./... 2>&1; then
    STEP_END=$(date +%s)
    echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
else
    echo -e "${RED}FAILED${NC} - Tests failed"
    FAILED=1
fi
echo ""

# ============================================================
# 2. Run comprehensive static analysis
# ============================================================
echo -e "${BLUE}[2/4] Running comprehensive static analysis...${NC}"
STEP_START=$(date +%s)

if command -v golangci-lint &> /dev/null; then
    if golangci-lint run --timeout=5m ./... 2>&1; then
        STEP_END=$(date +%s)
        echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
    else
        echo -e "${RED}FAILED${NC} - Static analysis found issues"
        FAILED=1
    fi
else
    echo -e "${YELLOW}SKIPPED${NC} - golangci-lint not installed"
    echo -e "Install: ${YELLOW}go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest${NC}"
fi
echo ""

# ============================================================
# 3. Check for vulnerabilities (go mod)
# ============================================================
echo -e "${BLUE}[3/4] Checking for module vulnerabilities...${NC}"
STEP_START=$(date +%s)

if command -v govulncheck &> /dev/null; then
    if govulncheck ./... 2>&1; then
        STEP_END=$(date +%s)
        echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
    else
        echo -e "${RED}FAILED${NC} - Vulnerabilities found"
        FAILED=1
    fi
else
    # Fallback to basic go mod verify
    if go mod verify 2>&1; then
        STEP_END=$(date +%s)
        echo -e "${GREEN}PASSED${NC} (module verification) ($(($STEP_END - $STEP_START))s)"
        echo -e "${YELLOW}TIP:${NC} Install govulncheck for better security scanning:"
        echo -e "     ${YELLOW}go install golang.org/x/vuln/cmd/govulncheck@latest${NC}"
    else
        echo -e "${RED}FAILED${NC} - Module verification failed"
        FAILED=1
    fi
fi
echo ""

# ============================================================
# 4. Verify build
# ============================================================
echo -e "${BLUE}[4/4] Verifying build...${NC}"
STEP_START=$(date +%s)

if go build -o /dev/null ./... 2>&1; then
    STEP_END=$(date +%s)
    echo -e "${GREEN}PASSED${NC} ($(($STEP_END - $STEP_START))s)"
else
    echo -e "${RED}FAILED${NC} - Build failed"
    FAILED=1
fi
echo ""

# ============================================================
# Summary
# ============================================================
END_TIME=$(date +%s)
TOTAL_TIME=$(($END_TIME - $START_TIME))

echo -e "${BLUE}=== Summary ===${NC}"
echo -e "Total time: ${TOTAL_TIME}s"
echo ""

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}Pre-push checks FAILED${NC}"
    echo ""
    echo -e "Fix the issues above, or bypass with: ${YELLOW}git push --no-verify${NC}"
    exit 1
fi

echo -e "${GREEN}All pre-push checks passed!${NC}"
exit 0
